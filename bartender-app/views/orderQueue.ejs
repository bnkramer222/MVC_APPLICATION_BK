<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Order Queue</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <a href="/">← Home</a>
  </nav>

  <div class="page-header">
    <h1>Order Queue</h1>
    <% if (orders.length > 0) { %>
      <form action="/order-queue/clear" method="POST" onsubmit="return confirm('Clear all orders from the queue?');">
        <button type="submit" class="btn-danger">Clear Queue</button>
      </form>
    <% } %>
  </div>

  <% if (orders.length === 0) { %>
    <p class="empty-state">No orders in the queue.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Cocktail</th>
          <th>Patron</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(order => { %>
          <tr>
            <td><%= order.id %></td>
            <td><%= order.cocktailName %></td>
            <td><%= order.patronName %></td>
            <td>
              <span class="status-badge <%= order.status === 'Ready for Pickup' ? 'status-ready' : 'status-pending' %>">
                <%= order.status %>
              </span>
            </td>
            <td>
              <% if (order.status !== 'Ready for Pickup') { %>
                <form action="/order-queue/<%= order.id %>/ready" method="POST">
                  <button type="submit" class="btn-primary">Mark Ready</button>
                </form>
              <% } else { %>
                ✅
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</body>
</html>