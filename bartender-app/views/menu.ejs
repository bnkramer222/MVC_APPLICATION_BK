<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Cocktail Menu</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <h1>Cocktail Menu</h1>
  <a href="/">← Back to Home</a>

  <% cocktails.forEach(cocktail => { %>
    <div class="cocktail-card">
      <h3><%= cocktail.name %> — $<%= cocktail.price.toFixed(2) %></h3>
      <p><%= cocktail.description %></p>
      <form action="/order" method="POST">
        <input type="hidden" name="cocktailId" value="<%= cocktail.id %>">
        <input type="text" name="patronName" placeholder="Your name" required>
        <button type="submit">Order This</button>
      </form>
    </div>
  <% }) %>
</body>
</html>