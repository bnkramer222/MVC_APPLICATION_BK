<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Cocktail Menu</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <a href="/">← Home</a>
  </nav>
  <h1>Cocktail Menu</h1>

  <div class="menu-grid">
    <% cocktails.forEach(cocktail => { %>
      <div class="cocktail-card">
        <h3><%= cocktail.name %></h3>
        <p class="price">$<%= cocktail.price.toFixed(2) %></p>
        <p class="description"><%= cocktail.description %></p>
        <form action="/order" method="POST">
          <input type="hidden" name="cocktailId" value="<%= cocktail.id %>">
          <input type="text" name="patronName" placeholder="Your name" required>
          <button type="submit" class="btn-primary">Order</button>
        </form>
      </div>
    <% }) %>
  </div>
</body>
</html>